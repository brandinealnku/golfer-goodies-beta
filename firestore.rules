rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function publicCourse(courseId) { return get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'active' && get(/databases/$(database)/documents/courses/$(courseId)).data.marketplaceVisible == true; }
  function signedInAs(uid) { return request.auth != null && request.auth.uid == uid; }
  function activeMember(courseId) { return request.auth != null && get(/databases/$(database)/documents/courses/$(courseId)/members/$(request.auth.uid)).data.status == 'active'; }
  function manager(courseId) { return activeMember(courseId) && get(/databases/$(database)/documents/courses/$(courseId)/members/$(request.auth.uid)).data.role in ['course_owner','course_manager']; }
  function profileFields() { return request.resource.data.keys().hasOnly(['version','uid','email','displayName','preferences','createdAt','updatedAt']) && request.resource.data.displayName is string; }
  match /courses/{courseId} { allow read: if resource.data.status == 'active' && resource.data.marketplaceVisible == true; allow write: if false;
    match /categories/{id} { allow read: if publicCourse(courseId); allow write: if false; }
    match /products/{id} { allow read: if publicCourse(courseId) && resource.data.publiclyVisible == true && resource.data.status in ['active','sold_out']; allow write: if false; }
    match /members/{uid} { allow read: if signedInAs(uid) && resource.data.status == 'active' || manager(courseId); allow write: if false; }
    match /auditLog/{id} { allow read: if manager(courseId); allow write: if false; }
    match /promotions/{id} { allow read: if publicCourse(courseId) && resource.data.active == true && resource.data.public == true; allow write: if false; }
  }
  match /users/{uid} { allow read: if signedInAs(uid); allow create: if signedInAs(uid) && profileFields() && request.resource.data.uid == uid; allow update: if signedInAs(uid) && profileFields() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt']); allow delete: if false; }
  match /courseClaims/{id} { allow read: if request.auth != null && resource.data.requestedBy == request.auth.uid; allow write: if false; }
  match /system/{id} { allow read, write: if false; }
  match /{document=**} { allow read, write: if false; }
}}
